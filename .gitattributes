# Auto detect text files and perform LF normalization
* text=auto

# Force LF line endings for scripts to avoid execution failures
*.sh text eol=lf
gradlew text eol=lf
**/gradlew text eol=lf

# Denote all files that are truly binary and should not be modified
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.aar binary
*.apk binary
